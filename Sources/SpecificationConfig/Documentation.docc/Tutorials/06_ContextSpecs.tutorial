@Tutorial(time: 25) {
    @Intro(title: "Contextual Specs with EvaluationContext") {
        Show how `EvaluationContext` from `DemoContextProvider` powers `ContextualSpecEntry` and how Config Pet’s UI reacts when flags, counters, or overrides change the validation story.

        @Image(source: "tutorial-icon", alt: "Contextual specs illustration")
    }

    @Section(title: "Provide a context for the pipeline") {
        @ContentAndMedia {
            `DemoContextProvider` builds the `EvaluationContext` that flows through `AppConfig.profile` via `AnyContextProvider(DemoContextProvider.shared)`. It supplies `currentDate`, `launchDate`, counters like `reloadCount`, and flags such as `nightTime` (derived from system time or the manual override) plus `sleepOverride` so `ContextualSpecEntry` can reason about time-sensitive rules.

            @Image(source: "tutorial-icon", alt: "Context flags")
        }

        @Steps {
            @Step {
                Create `DemoContextProvider` with reload counters and night overrides.
                @Code(name: "ContextProvider-State.swift", file: "01-ContextProvider-State.swift")
            }
            @Step {
                Add night-time detection plus a human-readable summary.
                @Code(name: "ContextProvider-Summary.swift", file: "02-ContextProvider-Summary.swift")
            }
            @Step {
                Build the `EvaluationContext` with counters and flags.
                @Code(name: "ContextProvider-Context.swift", file: "03-ContextProvider-Context.swift")
            }
        }
    }

    @Section(title: "Apply context-aware specs") {
        @ContentAndMedia {
            `ContextualSpecEntry` receives the same `EvaluationContext` that `ConfigPipeline.build` forwards during validation. `context.flag(for: "nightTime")` gates whether a sleeping pet is acceptable, and diagnostics mention the flag when the rule fails.

            @Image(source: "tutorial-icon", alt: "Contextual spec lens")
        }

        @Steps {
            @Step {
                Add a `ContextualSpecEntry` so pets can only sleep at night.
                @Code(name: "ContextualSpec-Binding.swift", file: "04-ContextualSpec-Binding.swift")
            }
            @Step {
                Inject `DemoContextProvider` into the profile so specs can query flags.
                @Code(name: "ContextProvider-Wiring.swift", file: "05-ContextProvider-Wiring.swift")
            }
        }
    }

    @Section(title: "Surface context in the UI") {
        @ContentAndMedia {
            The demo UI shows `ConfigManager.contextDescription` (for example, “Nighttime · Reloads: 3”), the night override button, and diagnostics so you can flip the context and see why the binding accepts or rejects `pet.isSleeping`. Tap “Force Night Mode”/“Clear Night Override” to call `ConfigManager.toggleNightMode()`, then use “Reload” (`ConfigManager.loadConfig()`) to rebuild and compare the diagnostics in day vs. night context.

            @Image(source: "tutorial-icon", alt: "Contextual UI illustration")
        }

        @Steps {
            @Step {
                Expose context helpers on `ConfigManager`.
                @Code(name: "ConfigManager-ContextHelpers.swift", file: "06-ConfigManager-ContextHelpers.swift")
            }
            @Step {
                Add a context row and night-mode toggle to the UI.
                @Code(name: "ContentView-ContextRow.swift", file: "07-ContentView-ContextRow.swift")
            }
        }
    }

    @Section(title: "Validation") {
        @ContentAndMedia {
            Run the standard verification commands so the documentation change leaves CI-green and the tutorials compile inside the doc catalog.
        }

        @Steps {
            @Step {
                `swift build -v`
            }
            @Step {
                `swift test -v`
            }
            @Step {
                `swiftformat --lint .`
            }
        }
    }
}
